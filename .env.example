# PostgreSQL (host bind 127.0.0.1:15432 — see docker-compose.yml)
POSTGRES_DB=eia_smartfix
POSTGRES_USER=eia_user
POSTGRES_PASSWORD=change_me_in_local_env

# --- Backend secrets (obligatoires pour Compose) ---
SPRING_DATASOURCE_USERNAME=eia_user
SPRING_DATASOURCE_PASSWORD=change_me_in_local_env
JWT_SECRET=change-this-to-a-secure-random-secret-at-least-256-bits-long-for-production
# Shorter access TTL; refresh 1 day (revocable server-side)
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=86400000
FILE_STORAGE_PATH=/data/documents
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:80

# Compose default profile is "prod". For local demo with seeds/Swagger:
#   cp docker-compose.override.example.yml docker-compose.override.yml
# Or set explicitly:
# SPRING_PROFILES_ACTIVE=dev
SPRING_PROFILES_ACTIVE=prod

# HttpOnly cookies: true behind HTTPS
APP_COOKIE_SECURE=false

# Keep false unless Ollama is running (docker compose --profile ai up -d)
KNOWLEDGE_ENABLED=false
KNOWLEDGE_PROVIDER=ollama
SPRING_AI_OLLAMA_CHAT_MODEL=llama3.2
SPRING_AI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# URLs — NE PAS décommenter pour Docker Compose (réseau interne).
# Ollama n'est plus publié sur l'hôte ; joignable uniquement via http://ollama:11434
#
# Dev local Maven + Postgres hôte :
#   SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/eia_smartfix
#   SPRING_DATASOURCE_PASSWORD=... (requis, plus de défaut)
# ---------------------------------------------------------------------------
