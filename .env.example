# PostgreSQL (Docker expose le port 15432 sur l'hôte — 5433 souvent bloqué par Hyper-V Windows)
POSTGRES_DB=eia_smartfix
POSTGRES_USER=eia_user
POSTGRES_PASSWORD=change_me_in_local_env

# --- Backend secrets (obligatoires pour Compose) ---
SPRING_DATASOURCE_USERNAME=eia_user
SPRING_DATASOURCE_PASSWORD=change_me_in_local_env
JWT_SECRET=change-this-to-a-secure-random-secret-at-least-256-bits-long-for-production
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000
FILE_STORAGE_PATH=/data/documents
# Origines CORS si le frontend n'utilise pas le proxy Vite (dev : 3000 ; Docker frontend : 80)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Profils Spring : local → dev | RAG Docker → dev,ai + --profile ai
SPRING_PROFILES_ACTIVE=dev

# Keep false unless Ollama is running (docker compose --profile ai up -d ollama)
KNOWLEDGE_ENABLED=false
KNOWLEDGE_PROVIDER=ollama
SPRING_AI_OLLAMA_CHAT_MODEL=llama3.2
SPRING_AI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# URLs — NE PAS décommenter pour Docker Compose (les défauts docker-compose.yml
# utilisent postgres:5432 et ollama:11434 à l'intérieur du réseau Compose).
#
# Dev local (Maven + Postgres publié sur l'hôte) :
#   SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/eia_smartfix
#   OLLAMA_BASE_URL=http://localhost:11434
#
# Backend dans Docker + Ollama profile ai :
#   OLLAMA_BASE_URL=http://ollama:11434
#   (laisser SPRING_DATASOURCE_URL non défini)
# ---------------------------------------------------------------------------

# Prod : profil "prod" + JWT_SECRET / SPRING_DATASOURCE_* / CORS_ALLOWED_ORIGINS obligatoires
# Voir backend/src/main/resources/application-prod.yml et docs/SECURITY.md
